# Copy this file to .env and fill in the values

PORT=5000

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/quizapp

# Any long random string, used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string

# Google Gemini API key (https://aistudio.google.com/app/apikey)
# Needed for "Ask AI" and "Generate quiz from PDF"
GOOGLE_API_KEY=
# Optional, defaults to gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Optional. If empty or unreachable, an in-memory cache is used instead
# e.g. redis://localhost:6379 or your Redis Cloud URL
REDIS_URL=

# Optional extra frontend URLs allowed by CORS, comma separated
CLIENT_URLS=
